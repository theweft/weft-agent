#
# /etc/weft/executor.env: the hooks, configured here and never by the decider. Each value is
# one command line, run with sh -c; documents reach it only as environment variables
# (WEFT_COMPONENT, WEFT_CONFIG, WEFT_CONFIG_HASH, WEFT_ARTIFACT).
WEFT_CONFIG_DIR=/etc/weft/config
WEFT_ON_CONFIG=/usr/libexec/weft/reload
WEFT_ON_INSTALL=/usr/libexec/weft/install
